<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivBase64Image"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginBottom="24dp"
        android:background="#E0E0E0"
        android:scaleType="centerCrop" />

    <Button
        android:id="@+id/btnChooseGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="בחר תמונה מהגלריה" />

    <Button
        android:id="@+id/btnSaveFirestore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="שמור ל-Firestore (Base64)" />

    <Button
        android:id="@+id/btnReadFirestore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="טתן תמונה מ-Firestore" />

</LinearLayout>